# copy to .env next to social-proxy.js
TOKEN_ENCRYPTION_KEY=   # 64 hex characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOCIAL_PROXY_KEY=       # 16+ random characters; also export it where you start api-bridge.js
SOCIAL_PROXY_PORT=4000
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# optional, for view/like counts in YouTube reports (read by api-bridge.js):
YOUTUBE_API_KEY=
